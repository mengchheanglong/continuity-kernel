{
  "name": "continuity-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down --volumes --remove-orphans",
    "db:setup": "tsx scripts/db-setup.ts",
    "test:db": "vitest run tests/database.test.ts --no-file-parallelism --bail=1",
    "test:dbos": "vitest run tests/dbos.test.ts tests/dbos-crash.test.ts --no-file-parallelism --bail=1",
    "test:gate-d": "vitest run tests/canonical.test.ts tests/database.test.ts tests/restate-foundation.test.ts tests/restate-crash.test.ts --no-file-parallelism --bail=1",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "4.23.6",
    "@dbos-inc/postgres-datasource": "4.23.6",
    "@restatedev/restate-sdk": "1.15.1",
    "@restatedev/restate-sdk-clients": "1.15.1",
    "canonicalize": "2.1.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.6.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.0.17"
  }
}
